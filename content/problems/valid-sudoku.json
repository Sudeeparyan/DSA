  "kidExplanation": "A Sudoku page. Every row, every column, and every 3\u00d73 box may show each digit at most once. Empty cells are fine.",
  "plainProblem": "Determine if a 9\u00d79 board is valid Sudoku so far (not necessarily solvable). '.' means empty.",
  "examples": [
    {
      "input": "valid partial board",
      "output": "true",
      "explanation": "No conflicts yet."
    },
    {
      "input": "duplicate digit in a box",
      "output": "false",
      "explanation": "Box rule broken."
    }
  ],
  "thinkingSteps": [
    {
      "title": "Brute force idea",
      "body": "For each filled cell, scan its row, column, and box."
    },
    {
      "title": "Aha insight",
      "body": "Keep three families of hash sets: rows, cols, boxes."
    },
    {
      "title": "Better idea",
      "body": "One pass: if a digit already sits in that row/col/box set, invalid; else add it."
    },
    {
      "title": "Box index trick",
      "body": "box = (r // 3) * 3 + (c // 3) labels the nine boxes."
    }
  ],
  "pattern": {
    "name": "Hash set / hash map for seen items",
    "whenToSpot": "You need fast lookups of values you already saw."
  },
  "solutions": {
    "python": "# Valid Sudoku \u2014 interview-friendly solution from NeetCode 150 repo\n# Comments explain the idea; logic is unchanged.\n\nclass Solution:\n    def isValidSudoku(self, board: List[List[str]]) -> bool:\n        seen = set()\n\n        for i in range(9):\n            for j in range(9):\n                if board[i][j] != \".\":\n                    num = board[i][j]\n                    if (\n                        (i, num) in seen\n                        or (num, j) in seen\n                        or (i // 3, j // 3, num) in seen\n                    ):\n                        return False\n                    seen.add((i, num))\n                    seen.add((num, j))\n                    seen.add((i // 3, j // 3, num))\n\n        return True\n",
    "cpp": null,
    "rust": null
  },
  "complexity": {
