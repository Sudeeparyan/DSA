      "explanation": "Special chars safe."
    }
  ],
  "thinkingSteps": [
    {
      "title": "Naive delimiter",
      "body": "Joining with commas fails if a string contains commas."
    },
    {
      "title": "Aha insight",
      "body": "Store length prefixes: 4#lint4#code \u2026 so you always know how many characters to read."
    },
    {
      "title": "Better idea",
      "body": "Encode walks strings appending len + '#' + body. Decode reads numbers until '#', then slices."
    },
    {
      "title": "Why interviewers like it",
      "body": "Shows careful parsing and edge-case thinking."
    }
  ],
  "pattern": {
    "name": "Hash set / hash map for seen items",
    "whenToSpot": "You need fast lookups of values you already saw."
  },
  "solutions": {
    "python": "# Encode and Decode Strings \u2014 interview-friendly solution from NeetCode 150 repo\n# Comments explain the idea; logic is unchanged.\n\nclass Codec:\n    def encode(self, strs: List[str]) -> str:\n        encoded = \"\"\n        for s in strs:\n            encoded += str(len(s)) + \"#\" + s\n        return encoded\n\n    def decode(self, s: str) -> List[str]:\n        decoded = []\n        i = 0\n        while i < len(s):\n            delimiter_pos = s.find(\"#\", i)\n            size = int(s[i:delimiter_pos])\n            start_pos = delimiter_pos + 1\n            end_pos = start_pos + size\n            decoded.append(s[start_pos:end_pos])\n            i = end_pos\n        return decoded\n",
    "cpp": null,
    "rust": null
  },
