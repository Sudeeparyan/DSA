 "pattern": "Fast exponentiation (square the half)",
 "statement": "Implement `pow(x, n)`: compute `x` raised to the integer power `n` (which may be negative).",
 "example": {
  "input": "x = 2.0, n = 10",
  "output": "1024.0",
  "why": "2¹⁰ = (2⁵)² = 32² = 1024."
 },
