 "pattern": "Tree = connected + exactly n − 1 edges",
 "statement": "There are `n` nodes labelled `0 … n − 1` and a list of undirected `edges`. Return `True` if these edges form a valid **tree**: all nodes connected, and no cycle.",
 "example": {
  "input": "n = 5, edges = [[0,1],[0,2],[0,3],[1,4]]",
  "output": "True",
  "why": "4 edges for 5 nodes, every node can be reached from node 0, and there is no cycle."
 },
 "more": [
  {
   "input": "n = 5, edges = [[0,1],[1,2],[2,3],[1,3],[1,4]]",
   "output": "False"
  },
  {
   "input": "n = 4, edges = [[0,1],[2,3]]",
   "output": "False"
  },
  {
   "input": "n = 1, edges = []",
   "output": "True"
  },
  {
   "input": "n = 4, edges = [[0,1],[2,3],[1,2]]",
   "output": "True"
  },
  {
   "input": "n = 5, edges = [[0,1],[1,2],[2,0],[3,4]]",
   "output": "False"
  }
 ],
 "idea": [
  "A tree on `n` nodes always has **exactly n − 1 edges**. Any other count can be rejected immediately.",
  "With the right number of edges, walk the graph by DFS from node 0. Seeing an already-visited node (other than the one we just came from) means there is a **cycle**.",
  "Finally the walk must have reached **all n nodes** — otherwise the graph is in several pieces."
 ],
 "code": "class Solution:\n    def validTree(self, n: int, edges: List[List[int]]) -> bool:\n        if len(edges) != n - 1:\n            return False\n\n        graph = defaultdict(list)\n        for u, v in edges:\n            graph[u].append(v)\n            graph[v].append(u)\n\n        visited = set()\n\n        def dfs(node, parent):\n            visited.add(node)\n            for neighbor in graph[node]:\n                if neighbor != parent:\n                    if neighbor in visited or not dfs(neighbor, node):\n                        return False\n            return True\n\n        # Check if the graph is connected\n        if not dfs(0, -1):\n            return False\n\n        return len(visited) == n",
 "complexity": {
  "time": "O(V + E)",
  "timeWhy": "Every node and edge is handled a constant number of times.",
  "space": "O(V + E)",
  "spaceWhy": "Adjacency list, visited set and recursion stack."
 },
