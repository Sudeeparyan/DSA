 "pattern": "Monotonic deque of indexes",
 "statement": "A window of size `k` slides over `nums` from left to right, one step at a time. Return the **maximum** value of every window.",
 "example": {
  "input": "nums = [1,5,3,2,1,4], k = 3",
  "output": "[5,5,3,4]",
  "why": "The windows are [1,5,3], [5,3,2], [3,2,1] and [2,1,4], with maximums 5, 5, 3 and 4."
 },
