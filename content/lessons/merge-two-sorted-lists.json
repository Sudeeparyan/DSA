 "difficulty": "Easy",
 "url": "https://leetcode.com/problems/merge-two-sorted-lists/",
 "pattern": "Dummy head + two pointers",
 "statement": "Given the heads of two **sorted** linked lists, merge them into one sorted list built from the same nodes, and return its head.",
 "example": {
  "input": "l1 = [1,4,5], l2 = [2,3,6]",
  "output": "[1,2,3,4,5,6]",
  "why": "Repeatedly taking the smaller front node gives 1, 2, 3, 4, 5, 6."
 },
 "more": [
  {
   "input": "l1 = [1,2,4], l2 = [1,3,4]",
   "output": "[1,1,2,3,4,4]"
  },
  {
   "input": "l1 = None, l2 = None",
   "output": "[]"
  },
  {
   "input": "l1 = None, l2 = [0]",
   "output": "[0]"
  },
  {
   "input": "l1 = [5], l2 = [1,2]",
   "output": "[1,2,5]"
  }
 ],
 "idea": [
  "Both lists are sorted, so the smallest node not yet used is always at the **front** of one of them.",
  "Compare the two fronts, link the smaller one onto the end of the merged list, and move that list's pointer forward.",
  "A **dummy** node at the start means the first real node needs no special case. When one list runs out, the rest of the other is already sorted — attach it in one go."
 ],
 "code": "class Solution:\n    def mergeTwoLists(self, l1: ListNode, l2: ListNode) -> ListNode:\n        dummy = ListNode()\n        current = dummy\n\n        while l1 and l2:\n            if l1.val < l2.val:\n                current.next = l1\n                l1 = l1.next\n            else:\n                current.next = l2\n                l2 = l2.next\n            current = current.next\n\n        if l1:\n            current.next = l1\n        elif l2:\n            current.next = l2\n\n        return dummy.next",
 "complexity": {
  "time": "O(n + m)",
  "timeWhy": "Each step links one node, and there are n + m nodes.",
  "space": "O(1)",
  "spaceWhy": "The existing nodes are re-linked; only a dummy node is created."
 },
