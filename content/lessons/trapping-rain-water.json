 "title": "Trapping Rain Water",
 "slug": "trapping-rain-water",
 "category": "two-pointers",
 "difficulty": "Hard",
 "url": "https://leetcode.com/problems/trapping-rain-water/",
 "pattern": "Two pointers with running maximums",
 "statement": "`height[i]` is the height of a bar of width 1. After it rains, water is trapped in the dips between bars. Return the total amount of trapped water.",
 "example": {
  "input": "height = [0,1,0,2,1,0,1,3,2,1,2,1]",
  "output": "6",
  "why": "1 unit sits at index 2, then 1 + 2 + 1 units at indexes 4–6, and 1 unit at index 9."
 },
 "more": [
  {
   "input": "height = [4,2,0,3,2,5]",
   "output": "9"
  },
  {
   "input": "height = [1,2,3]",
   "output": "0"
  },
  {
   "input": "height = [3,0,3]",
   "output": "3"
  }
 ],
 "idea": [
  "Water above a bar rises to the **lower** of the tallest wall on its left and the tallest wall on its right. Anything higher would spill over that lower wall.",
  "Use a pointer at each end and remember the tallest wall seen so far from each side (`max_left`, `max_right`).",
  "Always process the side whose bar is **lower**. The other side is known to have a wall at least that tall, so the water on this bar depends only on its own side's maximum: `max − height`."
 ],
 "code": "class Solution:\n    def trap(self, height: List[int]) -> int:\n        left, right = 0, len(height) - 1\n        max_left, max_right = 0, 0\n        trapped_water = 0\n\n        while left < right:\n            if height[left] <= height[right]:\n                if height[left] >= max_left:\n                    max_left = height[left]\n                else:\n                    trapped_water += max_left - height[left]\n                left += 1\n            else:\n                if height[right] >= max_right:\n                    max_right = height[right]\n                else:\n                    trapped_water += max_right - height[right]\n                right -= 1\n\n        return trapped_water",
 "complexity": {
  "time": "O(n)",
  "timeWhy": "Each step moves one pointer inward; every bar is handled once.",
  "space": "O(1)",
  "spaceWhy": "Two pointers, two maximums and a running total."
 },
