 "title": "Kth Largest Element in an Array",
 "slug": "kth-largest-element-in-an-array",
 "category": "heap-priority-queue",
 "difficulty": "Medium",
 "url": "https://leetcode.com/problems/kth-largest-element-in-an-array/",
 "pattern": "Min-heap of size k",
 "statement": "Given an integer array `nums` and an integer `k`, return the **k-th largest** element (in sorted order, not the k-th distinct one).",
 "example": {
  "input": "nums = [3,2,1,5,6,4], k = 2",
  "output": "5",
  "why": "Sorted from the largest: 6, 5, 4, 3, 2, 1 — the second one is 5."
 },
 "more": [
  {
   "input": "nums = [3,2,3,1,2,4,5,5,6], k = 4",
   "output": "4"
  },
  {
   "input": "nums = [1], k = 1",
   "output": "1"
  },
  {
   "input": "nums = [7,7,7], k = 2",
   "output": "7"
  }
 ],
 "idea": [
  "Sorting the whole array works in O(n log n), but we only care about the top k.",
  "Keep a **min-heap that never holds more than k numbers**: the k largest seen so far.",
  "Push every number; whenever the heap has k + 1 numbers, pop the smallest. At the end the top of the heap is the smallest of the k largest — the k-th largest."
 ],
 "code": "import heapq\n\nclass Solution:\n    def findKthLargest(self, nums: List[int], k: int) -> int:\n        min_heap = []\n\n        for num in nums:\n            heapq.heappush(min_heap, num)\n            if len(min_heap) > k:\n                heapq.heappop(min_heap)\n\n        return min_heap[0]",
 "complexity": {
  "time": "O(n log k)",
  "timeWhy": "Each of the n numbers costs one push (and maybe one pop) on a heap of size k.",
  "space": "O(k)",
  "spaceWhy": "The heap never holds more than k + 1 numbers."
 },
