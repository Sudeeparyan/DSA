{
 "id": 71,
 "number": 78,
 "title": "Subsets",
 "slug": "subsets",
 "category": "backtracking",
 "difficulty": "Medium",
 "url": "https://leetcode.com/problems/subsets/",
 "pattern": "Backtracking: choose → explore → undo",
 "statement": "Given an array `nums` of **unique** integers, return every possible subset (the power set). No subset may appear twice; any order is accepted.",
 "example": {
  "input": "nums = [1,2,3]",
  "output": "[[],[1],[1,2],[1,2,3],[1,3],[2],[2,3],[3]]",
  "why": "3 numbers, each either in or out: 2 × 2 × 2 = 8 subsets."
 },
 "more": [
  {
   "input": "nums = [0]",
   "output": "[[],[0]]"
  },
  {
   "input": "nums = [1,2]",
   "output": "[[],[1],[1,2],[2]]"
  }
 ],
 "idea": [
  "Build subsets one number at a time. At every moment the current partial choice is itself a subset — record it.",
  "To grow it, try each number that comes **after** the last one picked. Only moving forward means the same set is never produced twice in a different order.",
  "After exploring everything that starts with a pick, **undo** it (pop) and try the next number. Choose → explore → undo is the whole backtracking pattern."
 ],
 "code": "class Solution:\n    def subsets(self, nums: List[int]) -> List[List[int]]:\n        def backtrack(start, subset):\n            subsets.append(subset[:])  # Append a copy of the current subset\n\n            for i in range(start, len(nums)):\n                subset.append(nums[i])\n                backtrack(i + 1, subset)\n                subset.pop()  # Backtrack\n\n        subsets = []\n        backtrack(0, [])\n        return subsets",
 "complexity": {
  "time": "O(n · 2ⁿ)",
  "timeWhy": "There are 2ⁿ subsets and copying each one into the answer costs up to O(n).",
  "space": "O(n)",
  "spaceWhy": "The recursion is at most n deep and `subset` holds at most n numbers (not counting the output)."
 },
