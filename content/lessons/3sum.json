 "pattern": "Sort, fix one number, two pointers for the rest",
 "statement": "Given an integer array `nums`, return every triplet of three **different positions** whose values add up to 0. The answer must not contain the same triplet twice.",
 "example": {
  "input": "nums = [-1,0,1,2,-1,-4]",
  "output": "[[-1,-1,2],[-1,0,1]]",
  "why": "(-1) + (-1) + 2 = 0 and (-1) + 0 + 1 = 0. No other distinct triplet sums to 0."
 },
 "more": [
  {
