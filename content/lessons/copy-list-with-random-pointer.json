 "title": "Copy List with Random Pointer",
 "slug": "copy-list-with-random-pointer",
 "category": "linked-list",
 "difficulty": "Medium",
 "url": "https://leetcode.com/problems/copy-list-with-random-pointer/",
 "pattern": "Interleave copies with the originals",
 "statement": "Every node of a linked list has a `next` pointer and also a `random` pointer that may point to **any** node in the list (or to nothing). Build a completely separate deep copy of the list and return its head.",
 "example": {
  "input": "head = 7 → 13 → 11, where 13.random = 7, 11.random = 13 and 7.random = None",
  "output": "a new list 7 → 13 → 11 with the same random links, sharing no nodes with the original",
  "why": "The copy has the same values and the same shape, but every pointer leads to a copied node."
 },
 "more": [
  {
   "input": "head = [1,2]",
   "output": "[[1,2],[2,2]]"
  },
  {
   "input": "head = None",
   "output": "[]"
  }
 ],
 "idea": [
  "Copying `next` is easy. The hard part is `random`: when we copy a node, the copy of the node its random points to may not exist yet — and afterwards, how do we find it?",
  "Trick: put each copy **right after its original** (A → A′ → B → B′ …). Then the copy of any node `x` is simply `x.next`.",
  "So: (1) weave the copies in, (2) set each copy's random to `original.random.next`, (3) unweave the two lists again."
 ],
 "code": "class Solution:\n    def copyRandomList(self, head: \"Node\") -> \"Node\":\n        if not head:\n            return None\n\n        # Step 1: Duplicate nodes and insert them in between the original nodes\n        current = head\n        while current:\n            duplicate = Node(current.val)\n            duplicate.next = current.next\n            current.next = duplicate\n            current = duplicate.next\n\n        # Step 2: Update random pointers for the duplicate nodes\n        current = head\n        while current:\n            if current.random:\n                current.next.random = current.random.next\n            current = current.next.next\n\n        # Step 3: Split the combined list into two separate lists\n        original = head\n        duplicate_head = head.next\n        current = duplicate_head\n        while original:\n            original.next = original.next.next\n            if current.next:\n                current.next = current.next.next\n            original = original.next\n            current = current.next\n\n        return duplicate_head",
 "complexity": {
  "time": "O(n)",
  "timeWhy": "Three passes over the list.",
  "space": "O(1)",
  "spaceWhy": "No hash map is needed — the weaving itself remembers which copy belongs to which node."
 },
