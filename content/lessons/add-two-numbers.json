 "url": "https://leetcode.com/problems/add-two-numbers/",
 "pattern": "Digit-by-digit addition with a carry",
 "statement": "Two non-negative integers are stored as linked lists with their digits in **reverse order** (ones digit first). Add them and return the sum as a linked list in the same format.",
 "example": {
  "input": "l1 = [5,6], l2 = [7,8,9]",
  "output": "[2,5,0,1]",
  "why": "The lists mean 65 and 987. 65 + 987 = 1052, which is stored as 2 → 5 → 0 → 1."
 },
 "more": [
  {
   "input": "l1 = [2,4,3], l2 = [5,6,4]",
   "output": "[7,0,8]"
  },
  {
   "input": "l1 = [0], l2 = [0]",
   "output": "[0]"
  },
  {
   "input": "l1 = [9,9,9], l2 = [1]",
   "output": "[0,0,0,1]"
  }
 ],
 "idea": [
  "The digits come lowest first — exactly the order in which we add by hand: ones, then tens, then hundreds.",
  "Walk both lists together. At each position add the two digits and the **carry** from the previous position. Write down `total % 10` and carry `total // 10`.",
  "If one list is shorter, treat its missing digits as 0. If a carry is left at the very end, it becomes one more digit."
 ],
 "code": "class Solution:\n    def addTwoNumbers(self, l1: ListNode, l2: ListNode) -> ListNode:\n        dummy = ListNode()\n        current = dummy\n        carry = 0\n\n        while l1 or l2:\n            val1 = l1.val if l1 else 0\n            val2 = l2.val if l2 else 0\n            total = val1 + val2 + carry\n\n            carry = total // 10\n            digit = total % 10\n\n            current.next = ListNode(digit)\n            current = current.next\n\n            if l1:\n                l1 = l1.next\n            if l2:\n                l2 = l2.next\n\n        if carry:\n            current.next = ListNode(carry)\n\n        return dummy.next",
 "complexity": {
  "time": "O(max(n, m))",
  "timeWhy": "One step per digit of the longer number.",
  "space": "O(max(n, m))",
  "spaceWhy": "The result list has one node per digit (plus possibly one for the last carry)."
 },
