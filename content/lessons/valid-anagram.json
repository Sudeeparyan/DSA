 "title": "Valid Anagram",
 "slug": "valid-anagram",
 "category": "arrays-hashing",
 "difficulty": "Easy",
 "url": "https://leetcode.com/problems/valid-anagram/",
 "pattern": "Count letters with a hash map",
 "statement": "Given two strings `s` and `t`, return `True` if `t` is an **anagram** of `s` — it uses exactly the same letters the same number of times, just in a different order.",
 "example": {
  "input": "s = \"apple\", t = \"papel\"",
  "output": "True",
  "why": "Both words contain a×1, p×2, l×1, e×1."
 },
 "more": [
  {
   "input": "s = \"rat\", t = \"car\"",
   "output": "False"
  },
  {
   "input": "s = \"ab\", t = \"abc\"",
   "output": "False"
  },
  {
   "input": "s = \"aacc\", t = \"ccac\"",
   "output": "False"
  }
 ],
 "idea": [
  "Two words are anagrams when every letter appears the same number of times in both.",
  "Count the letters of `s` in a hash map: letter → how many.",
  "Then walk through `t` and *use up* one count per letter. If a letter is missing or already used up, it is not an anagram. Equal lengths guarantee nothing is left over at the end."
 ],
 "code": "class Solution:\n    def isAnagram(self, s: str, t: str) -> bool:\n        if len(s) != len(t):\n            return False\n\n        char_frequency = {}\n\n        # Build character frequency map for string s\n        for char in s:\n            char_frequency[char] = char_frequency.get(char, 0) + 1\n\n        # Compare with string t\n        for char in t:\n            if char not in char_frequency or char_frequency[char] == 0:\n                return False\n            char_frequency[char] -= 1\n\n        return True",
 "complexity": {
  "time": "O(n)",
  "timeWhy": "One pass over `s` to count and one pass over `t` to match.",
  "space": "O(1)",
  "spaceWhy": "The map holds at most one entry per distinct letter (26 for lowercase English)."
 },
