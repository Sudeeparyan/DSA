{
 "id": 72,
 "number": 39,
 "title": "Combination Sum",
 "slug": "combination-sum",
 "category": "backtracking",
 "difficulty": "Medium",
 "url": "https://leetcode.com/problems/combination-sum/",
 "pattern": "Backtracking with reuse allowed",
 "statement": "Given **distinct** positive integers `candidates` and a `target`, return every combination of candidates that adds up to `target`. The same number may be used **any number of times**. Two combinations are the same if they use each number the same number of times.",
 "example": {
  "input": "candidates = [2,3,5], target = 7",
  "output": "[[2,2,3],[2,5]]",
  "why": "2 + 2 + 3 = 7 and 2 + 5 = 7. No other mix of 2s, 3s and 5s reaches exactly 7."
 },
 "more": [
  {
   "input": "candidates = [2,3,6,7], target = 7",
   "output": "[[2,2,3],[7]]"
  },
  {
   "input": "candidates = [2], target = 1",
   "output": "[]"
  },
  {
   "input": "candidates = [2,3,5], target = 8",
   "output": "[[2,2,2,2],[2,3,3],[3,5]]"
  }
 ],
 "idea": [
  "Build a combination one number at a time and keep track of how much is **still missing** from the target.",
  "After picking `candidates[i]`, the next pick may be the same number again or a later one — never an earlier one. That keeps every combination in one fixed order, so `[2, 5]` is never produced again as `[5, 2]`.",
  "Missing amount 0 → a full combination, save it. A candidate larger than what is missing cannot help, so it is skipped. After exploring a pick, **undo** it and try the next candidate."
 ],
 "code": "class Solution:\n    def combinationSum(self, candidates: List[int], target: int) -> List[List[int]]:\n        def backtrack(start, target, combination):\n            if target == 0:\n                result.append(\n                    combination[:]\n                )  # Append a copy of the current combination\n                return\n\n            for i in range(start, len(candidates)):\n                if candidates[i] > target:\n                    continue  # Skip if the candidate is too large\n\n                combination.append(candidates[i])\n                backtrack(i, target - candidates[i], combination)\n                combination.pop()  # Backtrack\n\n        result = []\n        backtrack(0, target, [])\n        return result",
 "complexity": {
  "time": "O(n^(T/m))",
  "timeWhy": "T is the target and m the smallest candidate: a combination has at most T/m picks, and each pick has up to n choices.",
  "space": "O(T/m)",
  "spaceWhy": "The recursion and the current combination are at most T/m deep (not counting the output)."
 },
