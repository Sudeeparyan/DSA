 "pattern": "Binary search: one half is always sorted",
 "statement": "A sorted array of distinct numbers has been rotated (for example `[4,5,6,7,0,1,2]`). Return the index of `target`, or −1 if it is absent, in O(log n) time.",
 "example": {
  "input": "nums = [6,7,8,0,1,2,4,5], target = 8",
  "output": "2",
  "why": "nums[2] is 8."
 },
