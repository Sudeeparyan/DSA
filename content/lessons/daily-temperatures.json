 "title": "Daily Temperatures",
 "slug": "daily-temperatures",
 "category": "stack",
 "difficulty": "Medium",
 "url": "https://leetcode.com/problems/daily-temperatures/",
 "pattern": "Monotonic stack",
 "statement": "Given the daily `temperatures`, return a list where `answer[i]` is the number of days you have to wait after day `i` for a **warmer** temperature. Use 0 if no warmer day ever comes.",
 "example": {
  "input": "temperatures = [73,74,75,71,69,72,76,73]",
  "output": "[1,1,4,2,1,1,0,0]",
  "why": "For example day 2 (75°) waits 4 days for day 6 (76°); days 6 and 7 never see a warmer day."
 },
 "more": [
  {
   "input": "temperatures = [30,40,50,60]",
   "output": "[1,1,1,0]"
  },
  {
   "input": "temperatures = [30,60,90]",
   "output": "[1,1,0]"
  },
  {
   "input": "temperatures = [90,80,70]",
   "output": "[0,0,0]"
  }
 ],
 "idea": [
  "For each day, scanning forward for the next warmer day is O(n²).",
  "Walk **from right to left** and keep a stack of later days that could still be someone's *next warmer day*.",
  "A later day that is not warmer than today is useless from now on: today is closer *and* at least as warm, so today hides it. Pop those. Whatever is then on top is today's next warmer day."
 ],
 "code": "class Solution:\n    def dailyTemperatures(self, temperatures: List[int]) -> List[int]:\n        stack = []\n        result = [0] * len(temperatures)\n\n        for i in range(len(temperatures) - 1, -1, -1):\n            while stack and temperatures[i] >= temperatures[stack[-1]]:\n                stack.pop()\n            if stack:\n                result[i] = stack[-1] - i\n            stack.append(i)\n\n        return result",
 "complexity": {
  "time": "O(n)",
  "timeWhy": "Each day is pushed once and popped at most once.",
  "space": "O(n)",
  "spaceWhy": "When every day is colder than the next one (temperatures rising from left to right), nothing is ever popped and the stack ends up holding every day."
 },
