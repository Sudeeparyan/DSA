 "title": "Product of Array Except Self",
 "slug": "product-of-array-except-self",
 "category": "arrays-hashing",
 "difficulty": "Medium",
 "url": "https://leetcode.com/problems/product-of-array-except-self/",
 "pattern": "Prefix product × suffix product",
 "statement": "Given an integer array `nums`, return an array where `answer[i]` is the product of **every element except** `nums[i]`. It must run in O(n) time and may **not use division**.",
 "example": {
  "input": "nums = [1,2,3,4]",
  "output": "[24,12,8,6]",
  "why": "24 = 2·3·4, 12 = 1·3·4, 8 = 1·2·4, 6 = 1·2·3."
 },
 "more": [
  {
   "input": "nums = [-1,1,0,-3,3]",
   "output": "[0,0,9,0,0]"
  },
  {
   "input": "nums = [2,3]",
   "output": "[3,2]"
  }
 ],
 "idea": [
  "The product of everything except `nums[i]` splits into two parts: (everything to the **left** of i) × (everything to the **right** of i).",
  "A running product gives all the left parts in one left-to-right pass.",
  "A second pass from right to left carries the running product of the right parts and multiplies it in. Two passes, no division."
 ],
 "code": "class Solution:\n    def productExceptSelf(self, nums: List[int]) -> List[int]:\n        n = len(nums)\n        result = [1] * n\n\n        # Calculate the left product of each element\n        left_product = 1\n        for i in range(n):\n            result[i] *= left_product\n            left_product *= nums[i]\n\n        # Calculate the right product of each element and update the result list\n        right_product = 1\n        for i in range(n - 1, -1, -1):\n            result[i] *= right_product\n            right_product *= nums[i]\n\n        return result",
 "complexity": {
  "time": "O(n)",
  "timeWhy": "Two passes over the array.",
  "space": "O(1)",
  "spaceWhy": "Only two running products are stored besides the output array."
 },
