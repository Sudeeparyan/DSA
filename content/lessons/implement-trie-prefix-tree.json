 "title": "Implement Trie (Prefix Tree)",
 "slug": "implement-trie-prefix-tree",
 "category": "tries",
 "difficulty": "Medium",
 "url": "https://leetcode.com/problems/implement-trie-prefix-tree/",
 "pattern": "Tree of letters with end-of-word marks",
 "statement": "Implement a **trie** (prefix tree) with three operations: `insert(word)` stores a word, `search(word)` says whether that exact word was stored, and `startsWith(prefix)` says whether any stored word begins with the prefix.",
 "example": {
  "input": "Trie()\ninsert('cat')\ninsert('car')\nsearch('car')  →  True\nsearch('ca')  →  False\nsearch('cab')  →  False\nstartsWith('ca')  →  True",
  "output": "",
  "why": "'car' was inserted. 'ca' is only the beginning of stored words, and 'cab' leaves the tree at b."
 },
 "more": [
  {
   "input": "Trie()\ninsert('apple')\nsearch('apple')  →  True\nsearch('app')  →  False\nstartsWith('app')  →  True\ninsert('app')\nsearch('app')  →  True\nstartsWith('b')  →  False",
   "output": ""
  }
 ],
 "idea": [
  "Store words letter by letter in a tree: each node has one child per next letter. Words with the same beginning **share** the same path.",
  "To find a word, start at the root and follow its letters one at a time. If a letter has no branch, the word is not there.",
  "Reaching the last letter is not enough for `search` — `ca` must not count just because `cat` exists. So the node where a real word ends carries an **end-of-word mark**."
 ],
 "code": "class TrieNode:\n    def __init__(self):\n        self.children = {}\n        self.is_end = False\n\nclass Trie:\n    def __init__(self):\n        self.root = TrieNode()\n\n    def insert(self, word: str) -> None:\n        node = self.root\n        for char in word:\n            if char not in node.children:\n                node.children[char] = TrieNode()\n            node = node.children[char]\n        node.is_end = True\n\n    def search(self, word: str) -> bool:\n        node = self.root\n        for char in word:\n            if char not in node.children:\n                return False\n            node = node.children[char]\n        return node.is_end\n\n    def startsWith(self, prefix: str) -> bool:\n        node = self.root\n        for char in prefix:\n            if char not in node.children:\n                return False\n            node = node.children[char]\n        return True",
 "complexity": {
  "time": "O(L) per operation",
  "timeWhy": "Each operation follows one node per letter of the word (length L).",
  "space": "O(total letters)",
  "spaceWhy": "In the worst case every letter of every inserted word gets its own node."
 },
