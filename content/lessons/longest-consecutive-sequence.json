 "title": "Longest Consecutive Sequence",
 "slug": "longest-consecutive-sequence",
 "category": "arrays-hashing",
 "difficulty": "Medium",
 "url": "https://leetcode.com/problems/longest-consecutive-sequence/",
 "pattern": "Hash set + only count from sequence starts",
 "statement": "Given an unsorted array of integers, return the length of the longest run of **consecutive values** (such as 1, 2, 3, 4). The values can be anywhere in the array, and the algorithm must run in O(n) time.",
 "example": {
  "input": "nums = [100,4,200,1,3,2]",
  "output": "4",
  "why": "The values 1, 2, 3, 4 are all present, a run of length 4."
 },
 "more": [
  {
   "input": "nums = [0,3,7,2,5,8,4,6,0,1]",
   "output": "9"
  },
  {
   "input": "nums = []",
   "output": "0"
  },
  {
   "input": "nums = [1,2,0,1]",
   "output": "3"
  }
 ],
 "idea": [
  "Sorting would line the runs up, but sorting costs O(n log n). We need O(n).",
  "Put all numbers in a hash set. A number `x` **starts** a run exactly when `x − 1` is *not* in the set.",
  "Only from such a start, count upward: x + 1, x + 2, … while they are in the set. Numbers in the middle of a run are skipped, so every number is counted just once."
 ],
 "code": "class Solution:\n    def longestConsecutive(self, nums: List[int]) -> int:\n        num_set = set(nums)\n        max_length = 0\n\n        for num in num_set:\n            if num - 1 not in num_set:\n                current_num = num\n                current_length = 1\n\n                while current_num + 1 in num_set:\n                    current_num += 1\n                    current_length += 1\n\n                max_length = max(max_length, current_length)\n\n        return max_length",
 "complexity": {
  "time": "O(n)",
  "timeWhy": "The inner loop only runs from the start of a run, so each number is visited at most twice in total.",
  "space": "O(n)",
  "spaceWhy": "The set stores every distinct number."
 },
 "steps": [
