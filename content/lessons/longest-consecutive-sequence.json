  {"line":13,"text":"4 is in the set too, so the run grows: 1 … 4, length **4**.","views":[{"t":"array","id":"nums","title":"nums","cells":[{"v":"100"},{"v":"4"},{"v":"200"},{"v":"1"},{"v":"3"},{"v":"2"}]},{"t":"map","id":"num_set","title":"num_set","kind":"set","entries":[{"k":"1","tone":"good"},{"k":"2","tone":"good"},{"k":"3","tone":"good"},{"k":"4","tone":"good"},{"k":"100"},{"k":"200"}]},{"t":"vars","id":"vars","items":[{"k":"current_num","v":"4","changed":true},{"k":"current_length","v":"4","changed":true},{"k":"max_length","v":"0"}]}]},
  {"line":11,"text":"5 is not in the set, so the run that started at 1 ends at 4.","views":[{"t":"array","id":"nums","title":"nums","cells":[{"v":"100"},{"v":"4"},{"v":"200"},{"v":"1"},{"v":"3"},{"v":"2"}]},{"t":"map","id":"num_set","title":"num_set","kind":"set","entries":[{"k":"1","tone":"good"},{"k":"2","tone":"good"},{"k":"3","tone":"good"},{"k":"4","tone":"good"},{"k":"100"},{"k":"200"}]},{"t":"vars","id":"vars","items":[{"k":"current_num","v":"4"},{"k":"current_length","v":"4"},{"k":"max_length","v":"0"}]}]},
  {"line":15,"text":"This run has length 4. Longest so far: **4**.","views":[{"t":"array","id":"nums","title":"nums","cells":[{"v":"100"},{"v":"4"},{"v":"200"},{"v":"1"},{"v":"3"},{"v":"2"}]},{"t":"map","id":"num_set","title":"num_set","kind":"set","entries":[{"k":"1","tone":"good"},{"k":"2","tone":"good"},{"k":"3","tone":"good"},{"k":"4","tone":"good"},{"k":"100"},{"k":"200"}]},{"t":"vars","id":"vars","items":[{"k":"current_num","v":"4"},{"k":"current_length","v":"4"},{"k":"max_length","v":"4","changed":true}]}]},
